{
  "name": "avenir",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "api": "../../.venv/bin/python -m uvicorn api.application:app --host 127.0.0.1 --port 8015",
    "start": "node ../../scripts/run-app.mjs",
    "format": "prettier --write src index.html vite.config.ts",
    "format:check": "prettier --check src index.html vite.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "prettier": "3.6.2",
    "typescript": "5.6.3",
    "vite": "6.4.6"
  }
}
