# Copy to .env and fill in. Never commit .env.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# LLM for plain-English explanations and tag mapping (optional; template fallback without it)
LLM_ENABLED=false
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Grounded career guide via Anthropic directly (optional; used when LLM_BASE_URL is empty)
ANTHROPIC_API_KEY=

# Guide with tools on Gemini's OpenAI-compatible endpoint (see apps/web/api/README.md, "Guide tools").
# Uncomment and fill in your own key(s); never commit them.
# LLM_ENABLED=1
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=
# Optional second key, used once when the first hits a quota error (HTTP 429/403)
# LLM_API_KEY_2=
# Default: gemini-3.5-flash-lite (500 requests/day free tier); higher quality: gemini-3.8-flash (20/day)
# LLM_MODEL=gemini-3.5-flash-lite
# Guide reply cache for demo replays (default apps/web/api/.cache/guide, git-ignored); GUIDE_CACHE=0 turns it off
# GUIDE_CACHE_DIR=
# GUIDE_CACHE=

# Read guide answers aloud with Gemini text to speech (optional; the browser's speechSynthesis without it)
# GEMINI_API_KEY=
# GEMINI_API_KEY_2=
# TTS_MODEL=gemini-3.8-flash-tts

# Cluster sync (scripts/sync_to_cluster.sh); use an ssh alias, not a raw IP
CLUSTER_HOST=
CLUSTER_PATH=
