{
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LiveSwitch": {
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "title": "Enabled",
            "type": "boolean"
          }
        },
        "required": [
          "enabled"
        ],
        "title": "LiveSwitch",
        "type": "object"
      },
      "ProfileIn": {
        "additionalProperties": false,
        "properties": {
          "automation_worry": {
            "default": 0.5,
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Automation Worry",
            "type": "number"
          },
          "free_text": {
            "default": "",
            "maxLength": 300,
            "title": "Free Text",
            "type": "string"
          },
          "interests": {
            "description": "tag ids from GET /api/v1/tags",
            "items": {
              "type": "string"
            },
            "maxItems": 16,
            "title": "Interests",
            "type": "array"
          },
          "location": {
            "default": "Glasgow",
            "maxLength": 60,
            "title": "Location",
            "type": "string"
          },
          "nation": {
            "default": "scotland",
            "enum": [
              "scotland",
              "england",
              "wales",
              "northern_ireland"
            ],
            "title": "Nation",
            "type": "string"
          },
          "qualifications": {
            "items": {
              "$ref": "#/components/schemas/Qualification"
            },
            "maxItems": 20,
            "title": "Qualifications",
            "type": "array"
          }
        },
        "title": "ProfileIn",
        "type": "object"
      },
      "Qualification": {
        "additionalProperties": false,
        "properties": {
          "grade": {
            "anyOf": [
              {
                "maxLength": 3,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Grade"
          },
          "level": {
            "enum": [
              "national5",
              "higher",
              "advanced_higher",
              "gcse",
              "a_level"
            ],
            "title": "Level",
            "type": "string"
          },
          "subject": {
            "enum": [
              "maths",
              "english",
              "physics",
              "chemistry",
              "biology",
              "computing",
              "art",
              "design_technology",
              "graphic_communication",
              "geography",
              "business",
              "music"
            ],
            "title": "Subject",
            "type": "string"
          }
        },
        "required": [
          "subject",
          "level"
        ],
        "title": "Qualification",
        "type": "object"
      },
      "RecommendationRequest": {
        "additionalProperties": false,
        "properties": {
          "first_idea": {
            "description": "SOC 2020 code or free text, e.g. 'architect'",
            "maxLength": 80,
            "minLength": 1,
            "title": "First Idea",
            "type": "string"
          },
          "profile": {
            "$ref": "#/components/schemas/ProfileIn"
          }
        },
        "required": [
          "profile",
          "first_idea"
        ],
        "title": "RecommendationRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
