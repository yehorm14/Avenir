          "type": "string"
        },
        "vs_first_idea": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "description": "component -> pick score minus first-idea score; None if either is missing",
          "title": "Vs First Idea",
          "type": "object"
        }
      },
      "required": [
        "tier",
        "career",
        "components",
        "vs_first_idea",
        "reasons"
      ],
      "title": "Pick",
      "type": "object"
    },
    "Roadmap": {
      "additionalProperties": false,
      "properties": {
        "soc2020": {
          "title": "Soc2020",
          "type": "string"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/RoadmapStep"
          },
