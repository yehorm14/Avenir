  "additionalProperties": false,
  "properties": {
    "explanation": {
      "$ref": "#/$defs/Explanation"
    },
    "first_idea": {
      "anyOf": [
        {
          "$ref": "#/$defs/Career"
        },
        {
          "type": "null"
        }
      ]
    },
    "first_idea_components": {
      "anyOf": [
        {
          "$ref": "#/$defs/Components"
        },
        {
          "type": "null"
        }
      ]
    },
    "hedge": {
      "anyOf": [
        {
          "$ref": "#/$defs/Hedge"
        },
        {
          "type": "null"
        }
      ]
    },
    "notices": {
      "description": "FLAG_TEXT for every MUST_MENTION flag on a metric in this response; shown and cited by the LLM",
      "items": {
        "type": "string"
      },
      "title": "Notices",
      "type": "array"
    },
    "picks": {
      "description": "0-3; fewer if not enough careers pass the fit gate",
      "items": {
        "$ref": "#/$defs/Pick"
      },
      "maxItems": 3,
      "title": "Picks",
      "type": "array"
    },
    "roadmap": {
      "anyOf": [
        {
          "$ref": "#/$defs/Roadmap"
        },
        {
          "type": "null"
        }
      ]
