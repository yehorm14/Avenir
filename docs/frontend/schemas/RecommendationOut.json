      "type": "object"
    },
    "RoadmapStep": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "title": "Detail",
          "type": "string"
        },
        "order": {
          "maximum": 3,
          "minimum": 1,
          "title": "Order",
          "type": "integer"
        },
        "route": {
          "anyOf": [
            {
              "$ref": "#/$defs/Route"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "order",
        "title",
        "detail"
      ],
      "title": "RoadmapStep",
      "type": "object"
    },
